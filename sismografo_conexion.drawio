  <diagram id="sismo-page-1" name="Sismografo">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Conexion minima para que funcione con tu web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="arduino" value="Arduino UNO&#xa;&#xa;Pines a usar:&#xa;- 5V&#xa;- GND&#xa;- A4 (SDA)&#xa;- A5 (SCL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;fontSize=18;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="170" width="430" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="mpu" value="MPU6050 (GY-521)&#xa;&#xa;Pines a usar:&#xa;- VCC&#xa;- GND&#xa;- SDA&#xa;- SCL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=18;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="170" width="430" height="300" as="geometry"/>
        </mxCell>

        <mxCell id="stepbox" value="Paso a paso (armado basico)&#xa;1. Desconecta por ahora HC-05, LEDs y buzzer.&#xa;2. Conecta Arduino 5V -> MPU6050 VCC.&#xa;3. Conecta Arduino GND -> MPU6050 GND.&#xa;4. Conecta Arduino A4 -> MPU6050 SDA.&#xa;5. Conecta Arduino A5 -> MPU6050 SCL.&#xa;6. Conecta USB del Arduino al PC.&#xa;7. Abre tu web y prueba /api/sismo/simular o mueve el sensor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#f97316;fontSize=17;align=left;spacingLeft=14;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="120" y="540" width="1290" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="warn" value="No conectar ahora:&#xa;- Bluetooth HC-05 (usa RX/TX y complica la prueba)&#xa;- LEDs&#xa;- buzzer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="980" y="480" width="430" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="5V -> VCC" style="endArrow=block;endFill=1;strokeWidth=3;strokeColor=#ef4444;fontSize=15;fontStyle=1;" edge="1" parent="1" source="arduino" target="mpu">
